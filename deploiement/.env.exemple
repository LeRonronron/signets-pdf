# Copiez ce fichier sous le nom .env (dans le même dossier) puis remplissez les deux lignes.

# Votre nom de domaine, sans « https:// » ni « www » (exemple : signets-pdf.fr)
DOMAINE=

# Une adresse e-mail : Let's Encrypt s'en sert uniquement pour prévenir en cas de souci de certificat HTTPS
EMAIL=

# Taille maximale d'un livre déposé, en Mo
TAILLE_MAX_MO=300
